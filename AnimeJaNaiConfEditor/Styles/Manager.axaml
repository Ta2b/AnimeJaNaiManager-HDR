<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush">#F5F7FA</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackgroundBrush">#EDF1F6</SolidColorBrush>
          <SolidColorBrush x:Key="CardBackgroundBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SubtleBorderBrush">#DCE2EB</SolidColorBrush>
          <SolidColorBrush x:Key="MutedForegroundBrush">#586779</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionBackgroundBrush">#DBE8FC</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush">#151820</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackgroundBrush">#11141B</SolidColorBrush>
          <SolidColorBrush x:Key="CardBackgroundBrush">#1E232D</SolidColorBrush>
          <SolidColorBrush x:Key="SubtleBorderBrush">#343D4C</SolidColorBrush>
          <SolidColorBrush x:Key="MutedForegroundBrush">#AFBBCD</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionBackgroundBrush">#263F60</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Window"><Setter Property="FontSize" Value="14"/></Style>
  <Style Selector="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="TextBlock.page-title"><Setter Property="FontSize" Value="29"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.heading, TextBlock.section-title"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.muted, TextBlock.help"><Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="TextBlock.help"><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="Border.card, Border.section-card, Border.stage-card, Border.border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="7"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12"/><Setter Property="MinHeight" Value="46"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.profile-item"><Setter Property="Padding" Value="12,11"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.selected"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Button.secondary"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/></Style>
  <Style Selector="Button.accent, Button.active"><Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/></Style>
  <Style Selector="Expander"><Setter Property="CornerRadius" Value="9"/></Style>
  <Style Selector="Border.state"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="9,2"/><Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.state.active"><Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Border.state.active TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Border.state.blocked"><Setter Property="Background" Value="#F2A33C"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Border.state.blocked TextBlock"><Setter Property="Foreground" Value="#1F1400"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Border.blocked-card"><Setter Property="Background" Value="#26F2A33C"/><Setter Property="BorderBrush" Value="#F2A33C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/></Style>
  <Style Selector="Border.warning-card"><Setter Property="Background" Value="#26F2A33C"/><Setter Property="BorderBrush" Value="#F2A33C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style Selector="Border.notice-card"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,12"/></Style>
  <Style Selector="Border.result-card"><Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/></Style>
  <Style Selector="Window.compact TextBlock.nav-label"><Setter Property="IsVisible" Value="False"/></Style>
</Styles>
