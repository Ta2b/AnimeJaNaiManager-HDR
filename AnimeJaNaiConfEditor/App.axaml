<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AnimeJaNaiConfEditor.App"
             xmlns:local="using:AnimeJaNaiConfEditor"
             xmlns:hypertext="clr-namespace:HyperText.Avalonia;assembly=HyperText.Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <local:ViewLocator/>
  </Application.DataTemplates>

  <Application.Styles>
    <materialIcons:MaterialIconStyles />
    <sty:FluentAvaloniaTheme />

    <hypertext:HyperLinkStyle/>
    <StyleInclude Source="avares://AnimeJaNaiManager/Styles/Manager.axaml" />
    
  </Application.Styles>
</Application>