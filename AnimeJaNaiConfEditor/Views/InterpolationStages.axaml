<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AnimeJaNaiConfEditor.ViewModels" xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:Class="AnimeJaNaiConfEditor.Views.InterpolationStages" x:DataType="vm:UpscaleChain">
  <StackPanel Spacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4" Margin="0,0,16,0">
        <TextBlock Classes="section-title" Text="Processing steps" />
        <TextBlock Classes="muted" Text="Steps run from top to bottom. Select a step to change its settings." TextWrapping="Wrap" />
      </StackPanel>
      <Button Name="AddProcessingStep" Grid.Column="1" Content="＋ Add step" Classes="accent" VerticalAlignment="Top" IsEnabled="{Binding CanAddStage}" ToolTip.Tip="{Binding AddStageHint}">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel Spacing="6" MinWidth="240">
              <TextBlock Text="Choose a category" FontWeight="SemiBold" Margin="8,4,8,8" />
              <Button Content="Interpolation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding AddInterpolationStage}" Click="OnAddStep" />
              <Button Content="Upscale" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding AddUpscaleStage}" Click="OnAddStep" />
              <Button Content="Downscale" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding AddDownscaleStage}" Click="OnAddStep" />
              <Button Name="AddHdrStep" Content="HDR conversion" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding AddHdrStage}" IsEnabled="{Binding CanAddHdrStage}" ToolTip.Tip="{Binding HdrSetupHint}" Click="OnAddStep" />
              <TextBlock Classes="muted" Text="One HDR conversion per profile." Margin="8,4" TextWrapping="Wrap" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>
    <Border Classes="section-card" IsVisible="{Binding !HasStages}">
      <StackPanel Spacing="8">
        <TextBlock Text="Build your processing order" FontWeight="SemiBold" />
        <TextBlock Text="Add only the steps you need. For example: downscale → interpolation → upscale. Each step has its own technology and settings." TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ListBox Name="OrderedStages" ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage, Mode=TwoWay}" IsVisible="{Binding HasStages}" IsEnabled="{Binding PipelineEditable}" Background="Transparent" BorderThickness="0" Padding="0">
      <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:InterpolationStage">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,8" ColumnSpacing="12">
            <CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding CanEnable}" ToolTip.Tip="{Binding Availability}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Header, StringFormat='Activate {0}'}" />
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Summary}" Classes="muted" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding StateLabel}" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Content="↑" Classes="secondary" Command="{Binding MoveUp}" IsEnabled="{Binding CanMoveUp}" ToolTip.Tip="Move step up" AutomationProperties.Name="Move step up" />
              <Button Content="↓" Classes="secondary" Command="{Binding MoveDown}" IsEnabled="{Binding CanMoveDown}" ToolTip.Tip="Move step down" AutomationProperties.Name="Move step down" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ContentControl Name="SelectedStepSettings" Content="{Binding SelectedStage}" IsVisible="{Binding HasSelectedStage}" HorizontalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:InterpolationStage">
          <Border Classes="section-card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section-title" Text="{Binding Header}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Remove" Classes="secondary" Command="{Binding Remove}" ToolTip.Tip="Remove this step from the rule" />
              </Grid>
              <Grid ColumnDefinitions="130,*" ColumnSpacing="12">
                <TextBlock Text="Technology" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Name="StageTechnology" HorizontalAlignment="Stretch" ItemsSource="{Binding TechnologyChoices}" SelectedItem="{Binding SelectedTechnology, Mode=TwoWay}" IsEnabled="{Binding TechnologyEditable}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:StageTechnology"><TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Reason}" /></DataTemplate></ComboBox.ItemTemplate>
                  <ComboBox.ItemContainerTheme><ControlTheme TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="IsEnabled" Value="{ReflectionBinding Available}" /></ControlTheme></ComboBox.ItemContainerTheme>
                </ComboBox>
              </Grid>
              <TextBlock Text="{Binding ModeNotice}" Classes="muted" TextWrapping="Wrap" />
              <Grid Name="RifeModeControls" ColumnDefinitions="130,*" ColumnSpacing="12" IsVisible="{Binding IsRife}">
                <TextBlock Text="RIFE mode" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Name="RifeMode" MinWidth="130" ItemsSource="{Binding PolicyChoices}" SelectedItem="{Binding Policy}" />
              </Grid>
              <Grid ColumnDefinitions="130,*" ColumnSpacing="12" IsVisible="{Binding HasModel}">
                <TextBlock Text="Model / variant" VerticalAlignment="Center" />
                <ui:FAComboBox Grid.Column="1" Name="StageModel" IsEditable="True" HorizontalAlignment="Stretch" Text="{Binding Model, Mode=TwoWay}" ItemsSource="{Binding ModelChoices}" />
              </Grid>
              <Grid ColumnDefinitions="130,*" ColumnSpacing="12" IsVisible="{Binding IsRife}">
                <TextBlock Text="Frame-rate factor" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="×" VerticalAlignment="Center" /><TextBox Name="StageNumerator" Width="68" Text="{Binding Numerator}" /><TextBlock Text="/" VerticalAlignment="Center" /><TextBox Name="StageDenominator" Width="68" Text="{Binding Denominator}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="130,*" ColumnSpacing="12" IsVisible="{Binding IsResize}"><ComboBox ItemsSource="{Binding ResizeUnitChoices}" SelectedItem="{Binding ResizeUnit}" /><TextBox Name="DownscaleHeight" Grid.Column="1" MaxWidth="180" HorizontalAlignment="Left" Text="{Binding ResizeValue}" /></Grid>
              <Grid ColumnDefinitions="130,*" ColumnSpacing="12" IsVisible="{Binding IsNvidiaHdr}"><TextBlock Text="Peak (nits)" VerticalAlignment="Center" /><TextBox Name="HdrPeak" Grid.Column="1" MaxWidth="180" HorizontalAlignment="Left" Text="{Binding HdrPeak}" /></Grid>
              <Button Content="Use installed TrueHDR SDK" Command="{Binding UseInstalledHdrSdk}" IsVisible="{Binding CanUseInstalledHdrSdk}" HorizontalAlignment="Left" />
              <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8"><TextBlock Name="StepAvailability" Text="{Binding Availability}" TextWrapping="Wrap" /><Button Content="Manage engines and models…" Classes="secondary" Command="{Binding OpenEngineSetup}" IsVisible="{Binding HasAvailabilityAction}" HorizontalAlignment="Left" /></StackPanel>
              </Border>
              <Expander Header="Advanced settings" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Margin="0,8,0,0">
                  <StackPanel Spacing="6" IsVisible="{Binding IsLegacySizing}">
                    <Button Content="Use downscale-only sizing" Command="{Binding UseDownscaleOnlySizing}" HorizontalAlignment="Left" />
                    <TextBlock Classes="muted" Text="This disables the step and removes the imported sizing behavior. Check the target size before activating it again." TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding CanUseSelectedBackend}">
                    <Button Content="{Binding BackendChangeLabel}" Command="{Binding UseSelectedBackend}" HorizontalAlignment="Left" />
                    <TextBlock Classes="muted" Text="This disables the step and keeps its model and settings. Check its compatibility before activating it again." TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Classes="muted" IsVisible="{Binding NeedsResizeTechnologyChange}" Text="To use the selected backend, choose a compatible downscale technology above. The current algorithm is preserved until you change it." TextWrapping="Wrap" />
                  <StackPanel IsVisible="{Binding IsRife}" Spacing="10">
                    <CheckBox Content="Ensemble" IsChecked="{Binding Ensemble}" />
                    <Grid ColumnDefinitions="150,*"><TextBlock Text="Scene threshold" VerticalAlignment="Center" /><TextBox Name="SceneThreshold" Grid.Column="1" MaxWidth="180" HorizontalAlignment="Left" Text="{Binding SceneThreshold}" /></Grid>
                  </StackPanel>
                  <StackPanel IsVisible="{Binding IsUpscale}" Spacing="10">
                    <Grid ColumnDefinitions="150,*"><TextBlock Text="Temporal frames" VerticalAlignment="Center" /><TextBox Grid.Column="1" MaxWidth="180" HorizontalAlignment="Left" Text="{Binding Frames}" /></Grid>
                    <TextBlock Classes="muted" Text="0 detects the frame count from the model. Temporal models require a compatible reader." TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="150,*"><TextBlock Text="Scene threshold" VerticalAlignment="Center" /><TextBox Grid.Column="1" MaxWidth="180" HorizontalAlignment="Left" Text="{Binding TemporalThreshold}" /></Grid>
                  </StackPanel>
                  <StackPanel IsVisible="{Binding IsHdr}" Spacing="10">
                    <CheckBox Name="MpvHdrLook" IsVisible="{Binding IsMpvHdr}" Content="Use the TrueHDR tone curve" IsChecked="{Binding MpvHdrLook}" />
                    <Grid ColumnDefinitions="150,*"><TextBlock Text="Contrast (0–200)" /><TextBox IsEnabled="{Binding HdrToneCurveControls}" Grid.Column="1" Text="{Binding HdrContrast}" /></Grid>
                    <Grid ColumnDefinitions="150,*"><TextBlock Text="Saturation (0–200)" /><TextBox IsEnabled="{Binding HdrToneCurveControls}" Grid.Column="1" Text="{Binding HdrSaturation}" /></Grid>
                    <Grid ColumnDefinitions="150,*"><TextBlock Text="Middle grey (10–100)" /><TextBox IsEnabled="{Binding HdrToneCurveControls}" Grid.Column="1" Text="{Binding HdrMiddleGray}" /></Grid>
                    <StackPanel IsVisible="{Binding IsMpvHdr}" IsEnabled="{Binding MpvUnmatched}" Spacing="10">
                      <Grid ColumnDefinitions="150,*"><TextBlock Text="SDR white (nits)" /><TextBox Grid.Column="1" Text="{Binding MpvPaperWhite}" /></Grid>
                      <Grid ColumnDefinitions="150,*"><TextBlock Text="Highlights (0–100)" /><TextBox Grid.Column="1" Text="{Binding MpvHighlights}" /></Grid>
                      <Grid ColumnDefinitions="150,*"><TextBlock Text="Vibrance (0–80)" /><TextBox Grid.Column="1" Text="{Binding MpvVibrance}" /></Grid>
                    </StackPanel>
                  </StackPanel>
                  <Expander Header="Configuration details" HorizontalContentAlignment="Stretch"><StackPanel Spacing="6"><TextBlock Text="{Binding RuntimeLabel}" /><TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" /><TextBlock Text="{Binding OptionsText}" TextWrapping="Wrap" /></StackPanel></Expander>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <StackPanel Spacing="6">
      <TextBlock Name="OrderedProcessingOrder" Text="{Binding PipelineOrder}" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock Name="OrderedCadence" Text="{Binding PipelineCadence}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PipelineNotice}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="New steps start inactive. Configure them, then activate them with the checkbox in the list." Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>
</UserControl>
