<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnimeJaNaiConfEditor.ViewModels"
        xmlns:views="using:AnimeJaNaiConfEditor.Views"
        xmlns:local="using:AnimeJaNaiConfEditor"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hypertext="clr-namespace:HyperText.Avalonia.Controls;assembly=HyperText.Avalonia"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        WindowStartupLocation="CenterScreen"
        Width="1320" Height="900" MinWidth="740" MinHeight="540"
        x:Class="AnimeJaNaiConfEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="AnimeJaNai Manager" Background="{DynamicResource AppBackgroundBrush}">

  <Grid Name="ShellGrid" ColumnDefinitions="204,*" RowDefinitions="*,Auto">
    <Border Grid.RowSpan="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,24,12,16">
        <StackPanel Margin="10,0,0,28" Spacing="3">
          <TextBlock Text="AJ" FontWeight="Bold" FontSize="25" Foreground="{DynamicResource SystemAccentColor}" />
          <TextBlock Text="AnimeJaNai" Classes="nav-label" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="MANAGER" Classes="nav-label muted" FontSize="10" LetterSpacing="2" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
          <Button Name="ProfilesNavigation" Classes="nav" Classes.selected="{Binding ProfilesSelected}" Command="{Binding NavigateProfiles}" ToolTip.Tip="Profiles">
            <StackPanel Orientation="Horizontal" Spacing="12"><materialIcons:MaterialIcon Kind="LayersOutline" Width="21" Height="21"/><TextBlock Text="Profiles" Classes="nav-label"/></StackPanel>
          </Button>
          <Button Name="PreparationNavigation" Classes="nav" Classes.selected="{Binding PreparationSelected}" Command="{Binding ShowPreparation}" ToolTip.Tip="Prepare a video">
            <StackPanel Orientation="Horizontal" Spacing="12"><materialIcons:MaterialIcon Kind="MovieOpenOutline" Width="21" Height="21"/><TextBlock Text="Prepare a video" Classes="nav-label"/></StackPanel>
          </Button>
          <Button Name="EnginesNavigation" Classes="nav" Classes.selected="{Binding EnginesSelected}" Command="{Binding ShowEngines}" ToolTip.Tip="Engines and components">
            <StackPanel Orientation="Horizontal" Spacing="12"><materialIcons:MaterialIcon Kind="Chip" Width="21" Height="21"/><TextBlock Text="Engines" Classes="nav-label"/></StackPanel>
          </Button>
          <Button Name="SettingsNavigation" Classes="nav" Classes.selected="{Binding SettingsSelected}" Command="{Binding HandleShowGlobalSettings}" ToolTip.Tip="Settings">
            <StackPanel Orientation="Horizontal" Spacing="12"><materialIcons:MaterialIcon Kind="CogOutline" Width="21" Height="21"/><TextBlock Text="Settings" Classes="nav-label"/></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Grid.Row="2" Classes="nav-label muted" Margin="10,0" FontSize="11" Text="Make it your picture." TextWrapping="Wrap"/>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Name="PageHost" Margin="28,24,28,20">
      <Grid Name="ProfilesPage" IsVisible="{Binding ProfilesSelected}" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
          <StackPanel Spacing="4"><TextBlock Text="Profiles" Classes="page-title"/><TextBlock Text="Choose a look. Build the processing steps in their playback order." Classes="muted" TextWrapping="Wrap"/></StackPanel>
          <Button Name="NewProfileButton" Grid.Column="1" Content="New profile" Classes="accent" Command="{Binding AddProfile}" IsEnabled="{Binding CanAddProfile}" Margin="16,0,0,0" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock Grid.Row="1" Name="ProfileMigrationNotice" Text="{Binding ProfileMigrationNotice}" IsVisible="{Binding HasProfileMigrationNotice}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Grid.Row="2" Name="ProfileWorkspace" ColumnDefinitions="216,*">
          <Border Name="ProfileSidebar" Classes="section-card" Margin="0,0,20,0" Padding="8,12">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Text="YOUR PROFILES" Classes="muted" FontSize="10" LetterSpacing="1.3" Margin="10,0,0,12"/>
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding VisibleProfiles}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:UpscaleSlot">
                    <Button Classes="profile-item" Classes.selected="{Binding ActiveSlot}" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).HandleShowCustomProfile}" CommandParameter="{Binding SlotNumber}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2">
                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis"/><materialIcons:MaterialIcon Grid.Column="1" Kind="Star" Width="14" Height="14" IsVisible="{Binding IsSelectedMpvProfile}" Margin="8,0,0,0" ToolTip.Tip="Startup profile"/></Grid>
                    </Button>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Grid.Row="2" Classes="muted" FontSize="11" Text="{Binding ProfileCapacityNotice}" TextWrapping="Wrap" Margin="10,12,10,0"/>
            </Grid>
          </Border>
          <ScrollViewer Name="ProfileEditorScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18">
              <ComboBox Name="CompactProfilePicker" IsVisible="False" ItemsSource="{Binding VisibleProfiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch" PlaceholderText="Choose a profile">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:UpscaleSlot"><TextBlock Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Border Classes="section-card" IsVisible="{Binding !HasSelectedProfile}" Padding="28">
                <StackPanel Spacing="12"><materialIcons:MaterialIcon Kind="LayersOutline" Width="32" Height="32" HorizontalAlignment="Left"/><TextBlock Text="Your first profile starts here" Classes="heading"/><TextBlock Text="Add interpolation, upscale, downscale or HDR. Each step keeps its own technology and settings." Classes="muted" TextWrapping="Wrap"/><Button Content="Create a profile" Classes="accent" Command="{Binding AddProfile}" IsEnabled="{Binding CanAddProfile}" HorizontalAlignment="Left"/></StackPanel>
              </Border>
              <StackPanel IsVisible="{Binding HasSelectedProfile}" Spacing="16">
                <Border Classes="section-card" Padding="20">
                  <StackPanel Spacing="12">
                    <TextBlock Text="PROFILE NAME" Classes="muted" FontSize="10" LetterSpacing="1.2"/>
                    <TextBox Name="ProfileNameEditor" Text="{Binding CurrentSlot.ProfileName}" FontSize="20" FontWeight="SemiBold" PlaceholderText="Give this profile a name"/>
                    <WrapPanel>
                      <Button Name="DefaultProfileButton" Command="{Binding SelectDefaultProfile}" Classes="secondary" Margin="0,0,8,8" IsVisible="{Binding MpvConfDetected}">
                        <StackPanel Orientation="Horizontal" Spacing="7"><materialIcons:MaterialIcon Kind="StarOutline" Width="17" Height="17"/><TextBlock Text="{Binding DefaultProfileAction}"/></StackPanel>
                      </Button>
                      <Button Content="Profile actions" Classes="secondary" Margin="0,0,0,8">
                        <Button.Flyout><Flyout><StackPanel Spacing="6" MinWidth="180">
                          <Button Content="Duplicate profile" Command="{Binding DuplicateProfile}" IsEnabled="{Binding CanAddProfile}" HorizontalAlignment="Stretch"/>
                          <Button Content="Import into this profile…" Click="ImportCurrentProfileConfButtonClick" HorizontalAlignment="Stretch"/>
                          <Button Content="Export profile…" Click="ExportCurrentProfileConfButtonClick" HorizontalAlignment="Stretch"/>
                          <Separator Margin="0,4"/>
                          <Button Content="Delete profile…" Click="DeleteProfileButtonClick" HorizontalAlignment="Stretch"/>
                        </StackPanel></Flyout></Button.Flyout>
                      </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding ProfileOverview}" Classes="muted" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding CurrentSlot.Chains}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:UpscaleChain">
                    <StackPanel Spacing="12" Margin="0,0,0,20">
                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ChainNumber, StringFormat=Processing rule {0}}" Classes="heading"/><Button Grid.Column="1" Content="Remove rule" Classes="secondary" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DeleteChain}" CommandParameter="{Binding}"/></Grid>
                      <views:InterpolationStages/>
                      <Expander Header="When to use this rule" IsExpanded="False" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12" Margin="12">
                          <TextBlock Text="All videos match when maximum values are zero. If several rules match, their order determines which one is used." Classes="muted" TextWrapping="Wrap"/>
                          <TextBlock Text="Video resolution (width × height)"/>
                          <WrapPanel><ui:FAComboBox IsEditable="True" Width="140" Text="{Binding MinResolution, Mode=TwoWay}" ItemsSource="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CommonResolutions}"/><TextBlock Text="to" Margin="10,0"/><ui:FAComboBox IsEditable="True" Width="140" Text="{Binding MaxResolution, Mode=TwoWay}" ItemsSource="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CommonResolutions}"/></WrapPanel>
                          <TextBlock Text="Source frame rate"/>
                          <WrapPanel><ui:FANumberBox Value="{Binding MinFps}" Minimum="0" Maximum="999" Width="120"/><TextBlock Text="to" Margin="10,0"/><ui:FANumberBox Value="{Binding MaxFps}" Minimum="0" Maximum="999" Width="120"/><TextBlock Text="fps" Margin="8,0"/></WrapPanel>
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander Header="Add another activation rule" HorizontalAlignment="Stretch" IsExpanded="False">
                  <StackPanel Margin="12" Spacing="10"><TextBlock Classes="muted" TextWrapping="Wrap" Text="Use a separate processing chain for another source resolution or frame rate. A single rule is enough for most profiles."/><Button Content="Add rule" Command="{Binding AddChain}" HorizontalAlignment="Left"/></StackPanel>
                </Expander>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Grid Name="PreparationPage" IsVisible="{Binding PreparationSelected}"><views:Preparation DataContext="{Binding Preparation}"/></Grid>
      <ScrollViewer Name="EnginesPage" IsVisible="{Binding EnginesSelected}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="1100" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4"><TextBlock Text="Engines and components" Classes="page-title"/><TextBlock Text="Install what you need, then choose the technology inside each profile step." Classes="muted" TextWrapping="Wrap"/></StackPanel>
<Border Classes="border">
              <StackPanel Spacing="10">
                <TextBlock Text="Playback engine" FontWeight="SemiBold" FontSize="16" />
                <WrapPanel IsVisible="{Binding NotMacFeatures}">
                  <TextBlock Text="Inference engine" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <ToggleButton IsChecked="{Binding AnimeJaNaiConf.TensorRtSelected}" Content="TensorRT" Command="{Binding AnimeJaNaiConf.UserSelectTensorRt}" IsEnabled="{Binding TrtSelectable}" />
                  <ToggleButton IsChecked="{Binding AnimeJaNaiConf.VulkanSelected}" Content="Vulkan" IsVisible="{Binding LinuxFeatures}" IsEnabled="{Binding VulkanSelectable}" Command="{Binding AnimeJaNaiConf.UserSelectVulkan}" />
                  <ToggleButton IsChecked="{Binding AnimeJaNaiConf.MiGraphXSelected}" Content="MIGraphX + HIP" IsVisible="{Binding NotMacFeatures}" IsEnabled="{Binding MiGraphXSelectable}" Command="{Binding AnimeJaNaiConf.UserSelectMiGraphX}" />
                  <ToggleButton IsChecked="{Binding AnimeJaNaiConf.OpenVinoSelected}" Content="OpenVINO" IsVisible="{Binding LinuxFeatures}" IsEnabled="{Binding OpenVinoSelectable}" Command="{Binding AnimeJaNaiConf.UserSelectOpenVino}" />
                  <ToggleButton IsChecked="{Binding AnimeJaNaiConf.DirectMlSelected}" Content="DirectML" IsEnabled="{Binding WindowsFeatures}" Command="{Binding AnimeJaNaiConf.UserSelectDirectMl}" />
                </WrapPanel>
                <StackPanel Name="AppleSettingsPanel" IsVisible="{Binding MacFeatures}" Spacing="10">
                  <WrapPanel>
                    <TextBlock Text="Inference engine" Width="200" VerticalAlignment="Center" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.AppleOrtSelected}" Content="Core ML (ONNX Runtime)" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.AppleCoreMlSelected}" Content="Core ML (native)" IsEnabled="{Binding AppleCoreMlSelectable}" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.AppleMetalSelected}" Content="Metal" IsEnabled="{Binding AppleMetalSelectable}" />
                  </WrapPanel>
                  <TextBlock Classes="help" TextWrapping="Wrap" MaxLines="6" Text="Three engines run the same models. Core ML (ONNX Runtime) is the first one shipped. Core ML (native) gives Core ML the pictures directly, as 8-bit images. Metal runs the network on the GPU without Core ML. Run Benchmarks measures all three on this Mac." />
                  <WrapPanel>
                    <TextBlock Text="Compute target" Width="200" VerticalAlignment="Center" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.AppleDeviceAuto}" Content="Auto" IsEnabled="{Binding AnimeJaNaiConf.AppleDeviceChoice}" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.AppleDeviceGpu}" Content="GPU" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.AppleDeviceNpu}" Content="Neural Engine (NPU)" IsEnabled="{Binding AnimeJaNaiConf.AppleDeviceChoice}" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.AppleDeviceCpu}" Content="CPU" IsEnabled="{Binding AnimeJaNaiConf.AppleDeviceChoice}" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.AppleDeviceGpuNpu}" Content="GPU + Neural Engine" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.AppleDeviceGpuNpuCpu}" Content="GPU + Neural Engine + CPU" />
                  </WrapPanel>
                  <TextBlock Classes="help" TextWrapping="Wrap" MaxLines="6" Text="{Binding AnimeJaNaiConf.AppleDeviceNote}" />
                  <WrapPanel>
                    <TextBlock Text="Reuse unchanged pictures" Width="200" VerticalAlignment="Center" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.EngineReuseOff}" Content="Off" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.EngineReuseFrame}" Content="Whole frames" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.EngineReuseTiles}" Content="Areas of the frame" />
                  </WrapPanel>
                  <TextBlock Classes="help" TextWrapping="Wrap" MaxLines="6" Text="Anime holds a drawing for several frames and often moves only part of the picture. Whole frames: a frame identical to the last computed one keeps its result. Areas of the frame: when only a part of the picture changed (a mouth, a blink), only the areas that changed are computed; a frame where everything moves is computed whole." />
                  <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding AnimeJaNaiConf.EngineBoost}" IsEnabled="{Binding AnimeJaNaiConf.EngineBoostChoice}" Content="Balanced model on drawings that stay on screen (experimental)" />
                  <TextBlock Classes="help" TextWrapping="Wrap" MaxLines="6" Text="With a Performance profile and whole-frame reuse: a drawing held for several frames is computed once, with the Balanced model of the same family when the time it stays on screen covers it. Motion stays on the Performance model. Not applied to profiles that interpolate. Ctrl+J shows how often it is used." />
                  <WrapPanel>
                    <TextBlock Text="RIFE interpolation on" Width="200" VerticalAlignment="Center" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.RifeDeviceAuto}" Content="Auto" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.RifeDeviceGpu}" Content="GPU" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.RifeDeviceNpu}" Content="Neural Engine (NPU)" />
                    <ToggleButton IsChecked="{Binding AnimeJaNaiConf.RifeDeviceCpu}" Content="CPU" />
                  </WrapPanel>
                  <TextBlock Classes="help" TextWrapping="Wrap" MaxLines="6" Text="RIFE is enabled per profile (Profiles). Core ML runs it, on the processor chosen here, whichever engine upscales. Interpolating before the upscale costs less: the pictures between two frames are computed at the source size, then upscaled like a frame. Two identical frames (a held drawing) and scene cuts are not interpolated." />
                  <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding AnimeJaNaiConf.AppleAutoProfile}" Content="Move to a lighter profile when this Mac cannot keep up with the video" />
                  <TextBlock Classes="help" TextWrapping="Wrap" MaxLines="6" Text="The player measures the time spent on each frame and remembers the profile this Mac holds; Ctrl+R in the player forgets it and measures again, Ctrl+J shows the timings and where the model runs. Choose the startup profile in Profiles." />
                </StackPanel>
                <TextBlock Classes="help" IsVisible="{Binding NotMacFeatures}" Text="Engines that this GPU cannot use are greyed. TensorRT: NVIDIA. DirectML: Windows. Vulkan: Linux, any GPU. MIGraphX + HIP: AMD on Windows/Linux with the native engine and compatible runtime. OpenVINO: Intel on Linux. Choose the startup profile in Profiles; restart playback after changing the engine." />
                <TextBlock TextWrapping="Wrap" Foreground="Orange" IsVisible="{Binding HasBackendNotice}" Text="{Binding BackendNotice}" />
              </StackPanel>
            </Border>
<StackPanel Spacing="12" IsVisible="{Binding NotMacFeatures}">
        <TextBlock Text="{Binding ComponentManager.GpuText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <Border Classes="border" IsVisible="{Binding ComponentManager.SetupNeeded}">
          <Grid ColumnDefinitions="Auto,*">
            <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="20" Height="20" Foreground="Orange" VerticalAlignment="Top" Margin="0,2,8,0"/>
            <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="Components recommended for this PC are not installed. Check the highlighted items below, then click Apply changes to install them."/>
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding ComponentManager.Packs}" IsEnabled="{Binding ComponentManager.NotBusy}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComponentItem">
              <Border Classes="border">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <WrapPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding StateText}" Opacity="0.6" FontSize="12" IsVisible="{Binding !HighlightRecommended}"/>
                      <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding HighlightRecommended}">
                        <TextBlock Text="recommended for this PC" FontSize="12" FontWeight="SemiBold"/>
                      </Border>
                    </WrapPanel>
                    <TextBlock Classes="help" Text="{Binding Description}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" Opacity="0.8" Margin="12,0,0,0"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Apply changes" Command="{Binding ComponentManager.Apply}" IsEnabled="{Binding ComponentManager.NotBusy}" Classes="active"/>
          <Button Content="Refresh" Command="{Binding ComponentManager.Refresh}" IsEnabled="{Binding ComponentManager.NotBusy}"/>
        </StackPanel>
        <TextBlock Text="{Binding ComponentManager.StatusLine}" TextWrapping="Wrap" Opacity="0.7"/>
      </StackPanel>
<Expander Header="TensorRT engine settings" Name="EngineSettingsExpander" IsVisible="{Binding AnimeJaNaiConf.TensorRtSelected}" IsExpanded="False" HorizontalAlignment="Stretch">
              <StackPanel Spacing="12" Margin="10,12">
                <WrapPanel>
                  <TextBlock Text="Input shape" Width="150" VerticalAlignment="Center" />
                  <ToggleButton IsChecked="{Binding AnimeJaNaiConf.TrtStaticOnnxSelected}" Content="From ONNX" Command="{Binding AnimeJaNaiConf.SetTrtStaticOnnx}" />
                  <ToggleButton IsChecked="{Binding AnimeJaNaiConf.TrtStaticSelected}" Content="Static" Command="{Binding AnimeJaNaiConf.SetTrtStatic}" />
                  <ToggleButton IsChecked="{Binding AnimeJaNaiConf.TrtDynamicSelected}" Content="Dynamic" Command="{Binding AnimeJaNaiConf.SetTrtDynamic}" />
                </WrapPanel>
                <WrapPanel IsVisible="{Binding AnimeJaNaiConf.TrtDynamicSelected}">
                  <TextBlock Text="Minimum / optimal / maximum" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <TextBox Text="{Binding AnimeJaNaiConf.TrtDynamicMinResolution}" Width="120" />
                  <TextBox Text="{Binding AnimeJaNaiConf.TrtDynamicOptResolution}" Width="120" Margin="8,0" />
                  <TextBox Text="{Binding AnimeJaNaiConf.TrtDynamicMaxResolution}" Width="120" />
                </WrapPanel>
                <WrapPanel>
                  <TextBlock Text="Optimization level" Width="150" VerticalAlignment="Center" />
                  <TextBox Text="{Binding AnimeJaNaiConf.TrtBuilderOptimizationLevel}" Width="100" />
                </WrapPanel>
                <TextBlock Classes="help" Text="Static builds for the video resolution. Dynamic covers a resolution range. These settings affect new engines; existing cached engines are kept." />
                <TextBlock Text="Additional engine arguments" />
                <TextBox Text="{Binding AnimeJaNaiConf.TrtEngineSettings}" TextWrapping="Wrap" AcceptsReturn="True" />
              </StackPanel>
            </Expander>
<views:OptionalEngines DataContext="{Binding}" IsVisible="{Binding NotMacFeatures}"/>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="SettingsPage" IsVisible="{Binding SettingsSelected}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="1100" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4"><TextBlock Text="Settings" Classes="page-title"/><TextBlock Text="Your display and playback preferences, shared by all profiles." Classes="muted" TextWrapping="Wrap"/></StackPanel>
<StackPanel Name="GlobalSettingsPanel" MaxWidth="1080" HorizontalAlignment="Stretch" Margin="0" Spacing="12">


            <TextBlock Classes="help" TextWrapping="Wrap" Text="{Binding HdrSettings.SaveNotice}" IsVisible="{Binding HdrSettings.HasSaveNotice}" Foreground="Orange" />



            <Border Classes="border" Name="DisplaySettingsPanel">
              <StackPanel Spacing="10">
                <TextBlock Text="Display" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Classes="help" Text="These settings describe the display used for playback, independently of the graphics card." />
                <StackPanel DataContext="{Binding HdrSettings.Display}">
                  <StackPanel x:DataType="vm:DisplaySettings" Spacing="10">
                    <WrapPanel IsVisible="{Binding WindowsFeatures}">
                      <TextBlock Text="Windows HDR" Width="150" VerticalAlignment="Center" />
                      <ToggleButton IsChecked="{Binding WindowsHdrFollow}" Content="Follow system" />
                      <ToggleButton IsChecked="{Binding WindowsHdrEnable}" Content="Enable during playback" />
                    </WrapPanel>
                    <WrapPanel>
                      <TextBlock Text="Peak brightness" Width="150" VerticalAlignment="Center" />
                      <ToggleButton IsChecked="{Binding PeakAutoChoice}" Content="Auto" />
                      <ToggleButton IsChecked="{Binding PeakManual}" Content="Manual" />
                      <StackPanel Orientation="Horizontal" IsVisible="{Binding PeakManual}" Spacing="6" Margin="8,0,0,0">
                        <NumericUpDown Value="{Binding Peak}" Minimum="100" Maximum="10000" Increment="50" FormatString="0" Width="130" />
                        <TextBlock Text="nits" VerticalAlignment="Center" />
                      </StackPanel>
                    </WrapPanel>
                    <WrapPanel>
                      <TextBlock Text="Color gamut" Width="150" VerticalAlignment="Center" />
                      <ToggleButton IsChecked="{Binding GamutAuto}" Content="Auto" />
                      <ToggleButton IsChecked="{Binding GamutP3}" Content="Display P3" />
                      <ToggleButton IsChecked="{Binding GamutBt2020}" Content="BT.2020" />
                    </WrapPanel>
                    <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding Oled}" Content="This display is OLED" ToolTip.Tip="Enable only for a confirmed OLED display. The graphics card does not identify the panel technology." />
                  </StackPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding HdrOutputChoice}" Spacing="8">
                  <WrapPanel>
                    <TextBlock Text="{Binding HdrOutputLabel}" Width="150" VerticalAlignment="Center" />
                    <ToggleButton IsChecked="{Binding HdrSettings.LinuxAuto}" Content="{Binding HdrOutputAutoLabel}" />
                    <ToggleButton IsChecked="{Binding HdrSettings.LinuxSdr}" Content="SDR" />
                    <ToggleButton IsChecked="{Binding HdrSettings.LinuxPq}" Content="HDR PQ" />
                  </WrapPanel>
                  <TextBlock Classes="help" TextWrapping="Wrap" MaxLines="4" Text="{Binding HdrOutputHelp}" />
                </StackPanel>
                <TextBlock Classes="help" Text="Auto uses display information available to the player. Choose Manual only with a measured or calibrated peak. Ctrl+Alt+P opens the HDR calibration pattern." />
              </StackPanel>
            </Border>

            <Border Classes="border">
              <StackPanel Spacing="10">
                <TextBlock Text="Display HDR appearance" FontWeight="SemiBold" FontSize="16" />

                <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding HdrSettings.Enhance}" Content="Enable HDR grading" />
                <WrapPanel>
                  <TextBlock Text="Appearance" Width="150" VerticalAlignment="Center" />
                  <Button Content="Natural" Command="{Binding HdrSettings.PresetNatural}" />
                  <Button Content="Vivid" Command="{Binding HdrSettings.PresetVivid}" />
                  <Button Content="Maximum" Command="{Binding HdrSettings.PresetMaximum}" />
                </WrapPanel>
                <TextBlock Classes="help" Text="New installs use Natural. SDR stays SDR while system HDR is off. Ctrl+G compares the configured grade, Natural and grading off." />
                <Expander Header="Adjust HDR appearance" Name="HdrAppearanceExpander" IsExpanded="False" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="12" Margin="0,12,0,0">

                    <TextBlock Classes="help" TextWrapping="Wrap" IsVisible="{Binding LinuxFeatures}" Text="Add one HDR stage to a profile, then choose mpv HDR or NVIDIA TrueHDR inside that stage. The display controls below describe the screen." />
                    <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding HdrSettings.EnhanceNativeHdr}" Content="Also grade native HDR videos" />
                    <WrapPanel>
                      <TextBlock Text="Subtitle white" Width="180" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding HdrSettings.SubtitleWhite}" Minimum="80" Maximum="1000" Increment="10" FormatString="0" Width="120" />
                      <TextBlock Text="nits" Margin="6,0" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel IsEnabled="{Binding HdrSettings.EnhancementControlsEnabled}">
                      <TextBlock Text="Black depth" Width="180" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding HdrSettings.BlackDepth}" Minimum="0" Maximum="80" Increment="5" FormatString="0" Width="120" />
                      <TextBlock Text="%" Margin="6,0" VerticalAlignment="Center" />
                    </WrapPanel>


                    <WrapPanel>
                      <TextBlock Text="Highlights / vibrance" Width="180" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding HdrSettings.HighlightsRtx}" Minimum="0" Maximum="100" Increment="5" FormatString="0" Width="120" />
                      <NumericUpDown Value="{Binding HdrSettings.VibranceRtx}" Minimum="0" Maximum="80" Increment="5" FormatString="0" Width="120" Margin="8,0" />
                      <TextBlock Text="%" VerticalAlignment="Center" />
                    </WrapPanel>




                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <Expander Header="Playback and rendering" Name="PlaybackSettingsExpander" IsExpanded="False" HorizontalAlignment="Stretch" IsVisible="{Binding NotMacFeatures}">
              <StackPanel Spacing="12" Margin="10,12">
                <WrapPanel>
                  <TextBlock Text="Final scaling" Width="150" VerticalAlignment="Center" />
                  <ToggleButton IsChecked="{Binding HdrSettings.UpscaleAuto}" Content="Auto" />
                  <ToggleButton IsChecked="{Binding HdrSettings.UpscaleClassic}" Content="Standard" />
                  <ToggleButton IsChecked="{Binding HdrSettings.UpscaleOff}" Content="Off" />
                  <ToggleButton IsChecked="{Binding HdrSettings.UpscaleNvidia}" Content="RTX VSR" IsVisible="{Binding WindowsFeatures}" IsEnabled="{Binding RtxVsrSelectable}" />
                  <ToggleButton IsChecked="{Binding HdrSettings.UpscaleAmd}" Content="AMD VideoSR" IsVisible="{Binding WindowsFeatures}" IsEnabled="{Binding AmfSelectable}" />
                </WrapPanel>
                <WrapPanel IsVisible="{Binding WindowsFeatures}">
                  <TextBlock Text="Target resolution" Width="150" VerticalAlignment="Center" />
                  <ui:FAComboBox IsEditable="True" Width="160" Text="{Binding HdrSettings.TargetResolution, Mode=TwoWay}" ItemsSource="{Binding HdrTargetResolutions}" />
                </WrapPanel>
                <WrapPanel>
                  <TextBlock Text="Renderer" Width="150" VerticalAlignment="Center" />
                  <ToggleButton IsChecked="{Binding HdrSettings.RenderApiD3D11}" Content="Direct3D 11" IsVisible="{Binding WindowsFeatures}" />
                  <ToggleButton IsChecked="{Binding HdrSettings.RenderApiVulkan}" Content="Vulkan" />
                </WrapPanel>
                <StackPanel IsVisible="{Binding WindowsFeatures}" Spacing="10">
                  <WrapPanel>
                    <TextBlock Text="Extra interpolation" Width="150" VerticalAlignment="Center" />
                    <ToggleButton IsChecked="{Binding HdrSettings.FrameGenerationOff}" Content="Off" />
                    <ToggleButton IsChecked="{Binding HdrSettings.FrameGenerationAmf}" Content="AMD AMF ×2" IsEnabled="{Binding AmfSelectable}" />
                  </WrapPanel>
                  <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding AnimeJaNaiConf.AutoDisplayRefresh}" Content="Automatically change display refresh rate (experimental)" />
                </StackPanel>
                <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding HdrSettings.SmoothMotion}" Content="NVIDIA Smooth Motion (driver frame generation)" IsVisible="{Binding LinuxFeatures}" IsEnabled="{Binding SmoothMotionSelectable}" />
                <TextBlock Classes="help" TextWrapping="Wrap" IsVisible="{Binding LinuxFeatures}" Text="Smooth Motion needs an NVIDIA GPU and a driver that provides it; it is greyed otherwise. The driver generates one image between two displayed images, on the whole window, subtitles included, after RIFE and the upscaling. Restart the player after changing it. On Windows, set it in the NVIDIA app for this player; AMD and Intel have no equivalent on Linux." />
                <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding HdrSettings.RifeDisplaySync}" Content="Match enabled RIFE profiles to display refresh" />
                <WrapPanel IsVisible="{Binding HdrSettings.RifeDisplaySync}">
                  <TextBlock Text="Maximum RIFE factor" Width="150" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding HdrSettings.RifeMaxFactor}" Minimum="1" Maximum="8" Increment="1" FormatString="0" Width="120" />
                </WrapPanel>
                <TextBlock Classes="help" TextWrapping="Wrap" Text="{Binding GlobalFidelityNotice}" />
                <TextBlock Classes="help" TextWrapping="Wrap" Text="{Binding EnsemblePrecisionNotice}" />
                <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding AnimeJaNaiConf.GpuSubtitles}" Content="Render subtitles on GPU (experimental)" IsVisible="{Binding WindowsFeatures}" />
                <TextBlock Classes="help" Text="Renderer and experimental playback changes require restarting the player. Frame generation stays off until explicitly enabled." />
                <Expander Header="RTX Video controls" IsEnabled="{Binding RtxHdrSelectable}" IsExpanded="False">
                  <StackPanel Spacing="10" Margin="0,10">
                    <WrapPanel IsVisible="{Binding WindowsFeatures}">
                      <TextBlock Text="VSR quality" Width="150" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding HdrSettings.RtxVsrQuality}" Minimum="1" Maximum="4" Increment="1" FormatString="0" Width="110" />
                    </WrapPanel>
                    <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding HdrSettings.SkipHeldFrames}" Content="Reuse identical held frames" />
                    <TextBlock Classes="help" Text="{Binding VulkanPresentationNotice}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Expander>

            <StackPanel IsVisible="{Binding NotMacFeatures}">

            </StackPanel>


          </StackPanel>
          <Expander Header="Diagnostics and reference" Name="DiagnosticsExpander" HorizontalAlignment="Stretch" IsExpanded="False">
            <StackPanel Margin="16" Spacing="16">
              <CheckBox TextBlock.TextWrapping="Wrap" IsChecked="{Binding AnimeJaNaiConf.EnableLogging}" Content="Enable inference logging"/>
              <TextBlock Classes="muted" Text="Ctrl+Alt+H in the player opens the display and HDR diagnosis." TextWrapping="Wrap"/>
              <WrapPanel><Button Content="Run benchmarks" Click="RunBenchmarkButtonClick" Margin="0,0,8,8"/><Button Content="Submit to catalog…" Click="SubmitBenchmarkButtonClick" IsVisible="{Binding NotMacFeatures}" Margin="0,0,0,8"/></WrapPanel>
              <StackPanel Spacing="12">
        <TextBlock Text="Export playback reference" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Choose an open video session. The report describes the playback observed in the player, including its active chain and available file fingerprints. Unsaved settings in this editor are not applied." TextWrapping="Wrap"/>
        <Button Content="Refresh sessions" Command="{Binding Reference.Refresh}" IsEnabled="{Binding Reference.NotBusy}"/>
        <ComboBox ItemsSource="{Binding Reference.Sessions}" SelectedItem="{Binding Reference.SelectedSession}" IsEnabled="{Binding Reference.NotBusy}" MinWidth="0" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{ReflectionBinding Label}" TextWrapping="Wrap"/></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Export reference JSON…" Click="ExportReferenceButtonClick" IsEnabled="{Binding Reference.CanExport}"/>
        <TextBlock Text="{Binding Reference.Status}" TextWrapping="Wrap"/>
      </StackPanel>
            </StackPanel>
          </Expander>
          <Expander Header="Configuration files" HorizontalAlignment="Stretch" IsExpanded="False"><WrapPanel Margin="16"><Button Content="Import configuration…" Click="ImportFullConfButtonClick" Margin="0,0,8,8"/><Button Content="Export configuration…" Click="ExportFullConfButtonClick" Margin="0,0,0,8"/></WrapPanel></Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="28,10">
      <StackPanel Spacing="4"><TextBlock Text="{Binding BackendNotice}" IsVisible="{Binding HasBackendNotice}" TextWrapping="Wrap"/><TextBlock Classes="muted" FontSize="11" Text="Changes are saved automatically. Restart playback to apply a different engine." TextWrapping="Wrap"/></StackPanel>
    </Border>
  </Grid>
</Window>
